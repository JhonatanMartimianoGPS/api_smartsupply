model StockFornecedores {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome        String    @db.VarChar(200)
  email       String?   @db.VarChar(255)
  telefone    String?   @db.VarChar(50)
  observacoes String?   @db.VarChar(1000)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  grupo_id    String    @db.Uuid

  grupo          StockGrupos     @relation(fields: [grupo_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  stock_entradas StockEntradas[]
  stock_gastos   StockGastos[]

  @@index([grupo_id])
  @@map("fornecedores")
  @@schema("stock")
}
