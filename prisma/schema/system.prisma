// ─────────────────────────────────────────────────────────────────────────────
// 8. NOTIFICAÇÕES & GOVERNANÇA DO SISTEMA
// ─────────────────────────────────────────────────────────────────────────────

model AppNotification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  ticketId  String?  @map("ticket_id")
  // Tipo do aviso (new_order, order_status_change, new_ticket...): o frontend escolhe o ícone por ele
  type      String   @default("info")
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("app_notifications")
}

// Catálogo de módulos do sistema: os cards da tela inicial e o controle "módulo ativo/inativo".
// O id é o slug fixo que o frontend conhece (ex.: "pedido_mensal"); não há criação de módulo pela API.
model SystemModule {
  id          String   @id
  name        String
  description String?
  category    String // id de SystemModuleCategory; o service valida que existe
  enabled     Boolean  @default(true)
  icon        String? // nome do ícone (lucide) usado pelo frontend
  route       String?
  badge       String?
  roles       String[] @default([])
  updatedById String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_modules_config")
}

// Agrupa os módulos na tela de gerenciamento. O id é um slug escolhido na tela (ex.: "suprimentos").
model SystemModuleCategory {
  id          String   @id
  label       String
  description String?
  color       String?  @default("indigo")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_module_categories")
}

model AppConfig {
  id                   String   @id @default("default")
  minimumClientVersion String   @default("1.0.0") @map("minimum_client_version")
  maintenanceMode      Boolean  @default(false) @map("maintenance_mode")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

model UserPresence {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  city       String?
  region     String?
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_presence")
}

model TeamMember {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  name       String
  role       String
  email      String?
  phone      String?
  avatarUrl  String?  @map("avatar_url")
  regionalId String?  @map("regional_id")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  regional Regional? @relation(fields: [regionalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("team_members")
}
