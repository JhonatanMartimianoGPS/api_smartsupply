model Regionals {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @unique
  code         String   @unique
  active       Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  external_key String?  @db.Char(8)

  contract_categories        ContractCategories[]
  feed_posts                 FeedPosts[]
  product_categories         ProductCategories[]
  product_history            ProductHistory[]
  service_ticket_flows       ServiceTicketFlows[]
  service_ticket_types       ServiceTicketTypes[]
  supplier_service_regionals SupplierServiceRegionals[]
  team_members               TeamMembers[]
  user_regionals             UserRegionals[]
  contracts                  Contracts[]
  stock_grupos               StockGrupos[]
  products                   Products[]

  @@map("regionals")
  @@schema("public")
}
