model RoomsAccessRequests {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String
  email                    String
  status                   RoomsAccessRequestStatus @default(pending)
  review_notes             String?
  approved_role            RoomsAppRole?
  approved_organization_id String?                  @db.Uuid
  auth_user_id             String?                  @db.Uuid
  created_at               DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                 @default(now()) @db.Timestamptz(6)
  reviewed_at              DateTime?                @db.Timestamptz(6)
  reviewed_by              String?                  @db.Uuid

  approved_organization RoomsOrganizations? @relation(fields: [approved_organization_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  auth_user             Users?              @relation(fields: [auth_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reviewed_by_ref       RoomsProfiles?      @relation(fields: [reviewed_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, created_at(sort: Desc)], map: "idx_access_requests_status_created_at")
  @@map("access_requests")
  @@schema("rooms")
}
