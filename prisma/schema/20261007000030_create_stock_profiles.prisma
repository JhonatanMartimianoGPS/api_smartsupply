model StockProfiles {
  id         String    @id @db.Uuid
  nome       String    @db.VarChar(200)
  email      String    @db.VarChar(255)
  telefone   String?   @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  id_ref              Users                @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stock_profissionais StockProfissionais[]
  stock_entradas      StockEntradas[]
  stock_saidas        StockSaidas[]

  @@map("profiles")
  @@schema("stock")
}
