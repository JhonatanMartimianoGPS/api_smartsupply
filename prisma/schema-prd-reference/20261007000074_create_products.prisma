// ===========================================================================
// Table public.products
// Final consolidated version of the previous migrations.
// ===========================================================================

model Products {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo              String
  name                String
  unidade             String
  valor_unitario      Decimal  @db.Decimal(12, 2)
  categoria           String
  tabela              Int      @default(1)
  fornecedor          String?
  cr_filial           String?
  image_url           String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
  regional_id         String   @db.Uuid
  product_category_id String   @db.Uuid

  product_category              ProductCategories             @relation(fields: [product_category_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  regional                      Regionals                     @relation(fields: [regional_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order_items                   OrderItems[]
  product_category_availability ProductCategoryAvailability[]
  product_contract_availability ProductContractAvailability[]
  service_ticket_products       ServiceTicketProducts[]
  solicitation_items            SolicitationItems[]

  @@index([categoria, name], map: "idx_products_categoria_name")
  @@index([codigo(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_products_codigo_trgm")
  @@index([fornecedor], map: "idx_products_fornecedor")
  @@index([name], map: "idx_products_name_asc")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_products_name_trgm")
  @@index([product_category_id], map: "idx_products_product_category_id")
  @@index([regional_id], map: "idx_products_regional_active")
  @@index([regional_id], map: "idx_products_regional_id")
  @@index([regional_id, name], map: "idx_products_regional_name")
  @@map("products")
  @@schema("public")
}
