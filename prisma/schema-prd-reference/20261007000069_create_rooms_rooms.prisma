model RoomsRooms {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  floor             Int
  requires_approval Boolean  @default(false)
  description       String?
  organization_id   String?  @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  organization              RoomsOrganizations?      @relation(fields: [organization_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  rooms_room_blocking_rules RoomsRoomBlockingRules[]
  rooms_room_managers       RoomsRoomManagers[]
  rooms_bookings            RoomsBookings[]

  @@index([organization_id], map: "idx_rooms_organization_id")
  @@map("rooms")
  @@schema("rooms")
}
