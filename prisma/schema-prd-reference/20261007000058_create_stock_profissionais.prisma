// ===========================================================================
// Table stock.profissionais
// Final consolidated version of the previous migrations.
// ===========================================================================

model StockProfissionais {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String    @db.VarChar(200)
  email      String?   @db.VarChar(255)
  telefone   String?   @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  /// Vincula o profissional ao usuário do sistema (opcional). Quando preenchido, o sistema auto-preenche o responsável nas movimentações.
  user_id    String?   @db.Uuid
  grupo_id   String    @db.Uuid

  grupo                           StockGrupos            @relation(fields: [grupo_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user                            StockProfiles?         @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stock_entradas                  StockEntradas[]
  stock_inventario_itens          StockInventarioItens[]
  stock_saidas_by_responsavel_id  StockSaidas[]          @relation("saidas_responsavel_id_fkey")
  stock_saidas_by_retirado_por_id StockSaidas[]          @relation("saidas_retirado_por_id_fkey")

  @@index([nome], map: "idx_stock_profissionais_nome")
  @@index([grupo_id])
  @@map("profissionais")
  @@schema("stock")
}
