model RoomsProfiles {
  id         String   @id @db.Uuid
  name       String
  email      String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  id_ref                        Users                      @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rooms_access_requests         RoomsAccessRequests[]
  rooms_organization_members    RoomsOrganizationMembers[]
  rooms_room_managers           RoomsRoomManagers[]
  rooms_bookings_by_approved_by RoomsBookings[]            @relation("bookings_approved_by_fkey")
  rooms_bookings_by_user_id     RoomsBookings[]            @relation("bookings_user_id_profiles_fk")
  rooms_booking_history         RoomsBookingHistory[]

  @@map("profiles")
  @@schema("rooms")
}
