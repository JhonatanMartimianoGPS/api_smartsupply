generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  criadoEm DateTime @default(now())
}