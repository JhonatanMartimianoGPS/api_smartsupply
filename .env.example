# ==============================================================================
# GPS Bridge — Variáveis de Ambiente do Servidor (Backend Node.js)
# ==============================================================================

PORT=3000
NODE_ENV=development

# Conexão com o PostgreSQL (local ou Azure Database for PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gps_bridge?schema=public"

# Segurança de Autenticação JWT
JWT_SECRET="gps-bridge-super-secure-jwt-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="gps-bridge-refresh-secret-key-change-in-production-2026"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS (Permitir frontend)
CORS_ORIGIN="http://localhost:8080,http://localhost:5173,http://localhost:3000"

# Limite de tentativas de login por IP a cada 15 min (padrão 15). Suba só no ambiente local para rodar `npm test` várias vezes.
# AUTH_RATE_LIMIT_MAX=200
